APP_NAME="Forrest Booking"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://booking.hotel-tech.ai

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hotel_booking
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_COOKIE=FORREST_ADMIN

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Smoobu Integration
SMOOBU_PROVIDER=mock
SMOOBU_BASE_URL=https://login.smoobu.com/api/
SMOOBU_API_KEY=
SMOOBU_CHANNEL_ID=
SMOOBU_WEBHOOK_SECRET=
SMOOBU_TIMEOUT_SECONDS=8

# Admin Bootstrap
ADMIN_BOOTSTRAP_EMAIL=admin@hotel-tech.ai
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Admin

# SaaS Core Auth
SAAS_PLATFORM_URL=https://saas.hotel-tech.ai
SAAS_JWT_SECRET=

CORS_ALLOWED_ORIGINS=https://booking.hotel-tech.ai

# Email
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=booking@hotel-tech.ai
MAIL_FROM_NAME="${APP_NAME}"
